# Шаблон конфигурации aimedia. Скопируйте в локальный `.env` и заполните значения.
# Реальный `.env` не коммитится; секрет передаётся только значением переменной
# окружения, указанной в AIMEDIA_POLZA_API_KEY_ENV.

# Имя переменной окружения, в которой лежит ключ Polza. Сам ключ здесь не хранится.
AIMEDIA_POLZA_API_KEY_ENV=POLZA_API_KEY

# Значение ключа задаётся вне репозитория, например в вашем shell-профиле.
POLZA_API_KEY=

# Явный каталог данных вместо системного (platformdirs).
AIMEDIA_DATA_DIR=.local/dev-data

# Уровень диагностики: DEBUG/INFO/WARNING/ERROR/CRITICAL.
AIMEDIA_LOG_LEVEL=INFO

# Gate тестового контура; не является разрешением автоматически тратить деньги.
AIMEDIA_LIVE_ENABLED=0
