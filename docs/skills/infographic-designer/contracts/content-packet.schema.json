{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infographic-designer/content-packet.schema.json",
  "title": "Content packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic",
    "claims",
    "entities",
    "relationships",
    "exact_text",
    "data_values",
    "assumptions",
    "unknowns",
    "source_map"
  ],
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source_refs",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "assumption",
              "unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type",
          "directed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "directed": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exact_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "data_values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit": {
            "type": "string"
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceRef"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
