{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infographic-designer/qa-contract.schema.json",
  "title": "QA contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_type", "purpose", "audience", "primary_question", "primary_takeaway", "out_of_scope", "ground_truth", "gates", "required_rules", "comprehension_questions", "target"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string"},
    "artifact_type": {"enum": ["diagram", "infographic", "chart", "static-timeline"]},
    "purpose": {"type": "string"},
    "audience": {"type": "string"},
    "primary_question": {"type": "string"},
    "primary_takeaway": {"type": "string"},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "ground_truth": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gates": {"type": "array", "minItems": 1, "items": {"enum": ["G1_SEMANTIC", "G2_STRUCTURAL", "G3_RENDER_FIDELITY", "G4_RELEASE"]}},
    "required_rules": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$"}},
    "comprehension_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target": {
      "type": "object",
      "required": ["medium", "width", "height"],
      "properties": {"medium": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    }
  }
}
