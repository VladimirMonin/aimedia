{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infographic-designer/semantic-spec.schema.json",
  "title": "Semantic specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "primary_question",
    "primary_takeaway",
    "abstraction_level",
    "include",
    "exclude",
    "entities",
    "relationships",
    "exact_text",
    "data_values",
    "semantic_budget",
    "decomposition",
    "comprehension_questions",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "primary_question": {
      "type": "string",
      "minLength": 5
    },
    "primary_takeaway": {
      "type": "string",
      "minLength": 5
    },
    "abstraction_level": {
      "enum": [
        "overview",
        "system",
        "mechanism",
        "implementation"
      ]
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type",
          "directed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "directed": {
            "type": "boolean"
          },
          "critical": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "containment"}}, "required": ["type"]},
            "then": {"properties": {"directed": {"const": true}}}
          },
          {
            "if": {
              "allOf": [
                {"not": {"properties": {"type": {"const": "containment"}}, "required": ["type"]}},
                {"anyOf": [
                  {"properties": {"directed": {"const": true}}, "required": ["directed"]},
                  {"properties": {"critical": {"const": true}}, "required": ["critical"]}
                ]}
              ]
            },
            "then": {"required": ["label"], "properties": {"label": {"minLength": 1, "pattern": "\\S"}}}
          }
        ]
      }
    },
    "exact_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "data_values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit": {
            "type": "string"
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "semantic_budget": {
      "type": "object",
      "required": [
        "primary_entities",
        "relationship_types",
        "container_depth",
        "within_budget"
      ],
      "properties": {
        "primary_entities": {
          "type": "integer",
          "minimum": 1
        },
        "relationship_types": {
          "type": "integer",
          "minimum": 0
        },
        "container_depth": {
          "type": "integer",
          "minimum": 0
        },
        "within_budget": {
          "type": "boolean"
        },
        "overflow_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "decomposition": {
      "type": "object",
      "required": [
        "recommendation",
        "reason"
      ],
      "properties": {
        "recommendation": {
          "enum": [
            "one_visual",
            "series",
            "interactive"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "comprehension_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
