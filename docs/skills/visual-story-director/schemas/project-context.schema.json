                },
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "panel_ids",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "variant_id",
        "order",
        "declared_panel_count",
        "panels",
        "allowed_overlaps"
      ],
      "additionalProperties": false
    },
