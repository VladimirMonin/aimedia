          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "line_id",
        "speaker_id",
        "text"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "target_type": {
          "enum": [
            "comic_page",
            "single_panel",
