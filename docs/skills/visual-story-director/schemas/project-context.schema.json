{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "document_revision": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "project-context"
    },
    "context": {
      "$ref": "#/$defs/context"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "episode_id",
    "document_revision",
    "kind",
    "context"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "timing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "qualitative"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "estimated"
            },
            "range_seconds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "range_seconds",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "externally_supplied"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "start",
            "end",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "trait": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "user",
            "source",
            "agent"
          ]
        },
        "approval": {
          "enum": [
            "unknown",
            "proposed",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "name",
        "value",
        "origin",
        "approval"
      ],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity_kind": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "character": {
          "type": "string",
          "minLength": 1
        },
        "speech": {
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trait"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval": {
          "enum": [
            "unknown",
            "proposed",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "entity_kind",
        "role",
        "character",
        "speech",
        "traits",
        "invariants",
        "approval"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "prompt_block": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "enum": [
            "unknown",
            "proposed",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "prompt_block",
        "approval"
      ],
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "pronunciation_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_voice_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "speaker_id",
        "description",
        "pronunciation_notes"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "character_identity",
            "style",
            "location",
            "prop",
            "composition",
            "previous_frame"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "not_checked",
            "available",
            "missing"
          ]
        },
        "inspection": {
          "enum": [
            "not_inspected",
            "inspected"
          ]
        },
        "approval": {
          "enum": [
            "unknown",
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "availability_evidence": {
          "type": "string",
          "minLength": 1
        },
        "inspection_evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "role",
        "entity_id",
        "locator",
        "availability",
        "inspection",
        "approval"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "provided",
            "verified",
            "unverified"
          ]
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text",
        "source_locator",
        "verification"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "visible_event": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "source_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "interpretation": {
          "enum": [
            "literal",
            "metaphor",
            "fiction"
          ]
        },
        "metaphor_limit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "order",
        "purpose",
        "visible_event",
        "before",
        "after",
        "source_claim_ids",
        "interpretation"
      ],
      "additionalProperties": false
    },
    "text_variant": {
      "type": "object",
      "properties": {
        "field": {
          "enum": [
            "on_image_text",
            "spoken_text"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "const": "approved"
        }
      },
      "required": [
        "field",
        "reason",
        "approval"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "dialogue",
            "narration",
            "label"
          ]
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "canonical_text": {
          "type": "string",
          "minLength": 1
        },
        "on_image_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "spoken_text": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "delivery": {
          "type": "string"
        },
        "pronunciation_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval": {
          "enum": [
            "unknown",
            "proposed",
            "approved",
            "rejected"
          ]
        },
        "text_variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text_variant"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "speaker_id",
        "canonical_text",
        "on_image_text",
        "spoken_text",
        "delivery",
        "pronunciation_notes",
        "approval",
        "text_variants"
      ],
      "additionalProperties": false
    },
    "omission": {
      "type": "object",
      "properties": {
        "entity_type": {
          "enum": [
            "beat",
            "line"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "format": {
          "enum": [
            "comic_page",
            "single_panel",
            "vertical_strip"
          ]
        },
        "omissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/omission"
          }
        }
      },
      "required": [
        "id",
        "aspect_ratio",
        "format",
        "omissions"
      ],
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "properties": {
        "line_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "kind": {
          "enum": [
            "bubble",
            "caption",
            "label"
          ]
        },
        "tail_to": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "required": [
        "line_id",
        "rect",
        "kind"
      ],
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "location_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "prop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "text_zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          }
