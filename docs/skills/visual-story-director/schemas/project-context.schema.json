          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "origin_project_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "declared_panel_count": {
